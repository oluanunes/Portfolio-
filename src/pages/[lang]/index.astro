---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Doors from '../../components/Doors.astro';
import FeaturedSeries from '../../components/FeaturedSeries.astro';
import About from '../../components/About.astro';
import { LANGS, t, type Lang } from '../../i18n';

export const getStaticPaths = (() =>
  LANGS.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
---

<Base lang={lang} title={t(lang, 'meta.home.title')} description={t(lang, 'meta.home.description')} path="">
  <Hero lang={lang} />
  <Doors lang={lang} />
  <FeaturedSeries lang={lang} />
  <About lang={lang} />
</Base>
