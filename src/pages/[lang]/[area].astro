---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import AreaHero from '../../components/AreaHero.astro';
import Gallery from '../../components/Gallery.astro';
import Packages from '../../components/Packages.astro';
import AreaCta from '../../components/AreaCta.astro';
import { AREAS, type AreaSlug } from '../../content/areas';
import { SHOW_PACKAGES } from '../../content/site';
import { LANGS, t, type DictKey, type Lang } from '../../i18n';

export const getStaticPaths = (() =>
  LANGS.flatMap((lang) => AREAS.map((area) => ({ params: { lang, area } })))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const area = Astro.params.area as AreaSlug;
---

<Base
  lang={lang}
  title={t(lang, `meta.area.${area}.title` as DictKey)}
  description={t(lang, `meta.area.${area}.description` as DictKey)}
  path={`${area}/`}
>
  <AreaHero lang={lang} area={area} />

  <section class="intro">
    <div class="intro__inner">
      <h2 class="intro__title">{t(lang, `area.${area}.how.title` as DictKey)}</h2>
      <p class="intro__text">{t(lang, `area.${area}.how.text` as DictKey)}</p>
    </div>
  </section>

  <Gallery lang={lang} area={area} />
  {SHOW_PACKAGES && <Packages lang={lang} area={area} />}
  <AreaCta lang={lang} area={area} />
</Base>

<style>
  .intro {
    padding: 96px clamp(20px, 5vw, 64px) 48px;
  }
  .intro__inner {
    max-width: 1312px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px;
  }
  .intro__title {
    flex: 1 1 280px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(30px, 3.5vw, 44px);
    line-height: 1.12;
  }
  .intro__text {
    flex: 2 1 420px;
    max-width: 720px;
    margin: 0;
    font-size: 18px;
    line-height: 1.7;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .intro {
      padding: 56px clamp(20px, 5vw, 64px) 32px;
    }
    .intro__inner {
      gap: 20px;
    }
    .intro__text {
      font-size: 17px;
    }
  }
</style>
