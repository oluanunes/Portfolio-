---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/fonts.css';
import { LANGS, t, type Lang } from '../i18n';
import { href } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Rota sem o prefixo de idioma ('' na Home, 'portrait/' numa área). */
  path: string;
}
const { lang, title, description, path } = Astro.props;

const htmlLangs: Record<Lang, string> = { pt: 'pt-BR', fr: 'fr-CH', en: 'en' };
const absolute = (url: string) => new URL(url, Astro.site).href;

const canonical = absolute(href(`/${lang}/${path}`));
const alternates = LANGS.map((code) => ({
  hreflang: htmlLangs[code],
  href: absolute(href(`/${code}/${path}`)),
}));
const xDefault = absolute(href('/'));

const ogLocales: Record<Lang, string> = { pt: 'pt_BR', fr: 'fr_CH', en: 'en_US' };
const ogAlternates = LANGS.filter((code) => code !== lang).map((code) => ogLocales[code]);
---

<!doctype html>
<html lang={htmlLangs[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {ogAlternates.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <script is:inline src={href('/theme-init.js')}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'nav.skipToContent')}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 20;
    padding: 12px 16px;
    border-radius: 2px;
    background: var(--accent);
    color: var(--accent-text);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
</style>
