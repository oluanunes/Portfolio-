---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n';
import type { AreaSlug } from '../content/areas';
import { altFor, listPhotos } from '../lib/photos';

interface Props {
  lang: Lang;
  area: AreaSlug;
}
const { lang, area } = Astro.props;

const RATIOS = ['3 / 4', '1 / 1', '3 / 4', '4 / 5', '3 / 4', '1 / 1', '4 / 5'];

// A primeira foto já é a capa da página, então a galeria começa na segunda.
const items = listPhotos(area)
  .slice(1)
  .map((photo, i) => ({
    photo,
    alt: altFor(lang, area, i + 1),
    ratio: RATIOS[i % RATIOS.length],
  }));
---

<section class="gallery">
  <ul class="gallery__grid">
    {
      items.map((item) => (
        <li class="gallery__item" style={`aspect-ratio: ${item.ratio}`}>
          <Image
            class="gallery__photo"
            src={item.photo}
            alt={item.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw"
            format="webp"
            loading="lazy"
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .gallery {
    padding: 24px clamp(20px, 5vw, 64px) 96px;
  }
  .gallery__grid {
    max-width: 1312px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
  .gallery__item {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    background: #14110c;
  }
  .gallery__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .gallery {
      padding-bottom: 64px;
    }
    .gallery__grid {
      gap: 16px;
    }
  }
</style>
