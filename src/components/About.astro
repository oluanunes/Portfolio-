---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n';
import { href } from '../lib/url';
import { altFor, listPhotos } from '../lib/photos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const photo = listPhotos('portrait')[7];
const quote = `${href(`/${lang}/`)}#orcamento`;
---

<section class="about" id="about">
  <div class="about__inner">
    <div class="about__photo-wrap">
      <Image
        class="about__photo"
        src={photo}
        alt={altFor(lang, 'portrait', 7)}
        widths={[400, 640, 1040]}
        sizes="(min-width: 900px) 520px, 100vw"
        format="webp"
        loading="lazy"
      />
    </div>
    <div class="about__text">
      <h2 class="about__title">{t(lang, 'home.about.title')}</h2>
      <p class="about__body">{t(lang, 'home.about.text')}</p>
      <a class="about__cta" href={quote}>{t(lang, 'home.about.cta')}</a>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 112px clamp(20px, 5vw, 64px);
    background: var(--surface);
  }
  .about__inner {
    max-width: 1312px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 64px;
  }
  .about__photo-wrap {
    flex: 1 1 320px;
    max-width: 520px;
    aspect-ratio: 4 / 5;
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    background: #14110c;
  }
  .about__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about__text {
    flex: 1 1 380px;
    max-width: 600px;
  }
  .about__title {
    margin: 0 0 24px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.1;
  }
  .about__body {
    margin: 0 0 32px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--muted);
  }
  .about__cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 26px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 2px;
    border: 1px solid var(--text);
    color: var(--text);
  }

  @media (max-width: 768px) {
    .about {
      padding: 64px clamp(20px, 5vw, 64px);
    }
    .about__inner {
      gap: 32px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .about__cta {
      transition: opacity 150ms ease;
    }
    .about__cta:hover {
      opacity: 0.85;
    }
  }
</style>
