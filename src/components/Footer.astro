---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// E-mail público vindo do ambiente (PUBLIC_CONTACT_EMAIL). Vazio: o link não aparece.
const contactEmail: string = (import.meta.env.PUBLIC_CONTACT_EMAIL ?? '').trim();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <span>{t(lang, 'footer.copyright')}</span>
    {contactEmail !== '' && <a class="site-footer__mail" href={`mailto:${contactEmail}`}>{contactEmail}</a>}
  </div>
</footer>

<style>
  .site-footer {
    padding: 36px clamp(20px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }
  .site-footer__inner {
    max-width: 1312px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    font-size: 14px;
    color: var(--muted);
  }
  .site-footer__mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -12px;
    color: inherit;
  }
</style>
