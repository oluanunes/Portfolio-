---
import { Image } from 'astro:assets';
import { t, type DictKey, type Lang } from '../i18n';
import { AREAS, type AreaSlug } from '../content/areas';
import { altFor, listPhotos } from '../lib/photos';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const filters: (AreaSlug | 'all')[] = ['all', ...AREAS];

// Oito séries alternando as áreas. O índice da foto começa em 1 para a Home
// não repetir as fotos usadas nas portas (índice 0).
const items = Array.from({ length: 8 }, (_, i) => {
  const area = AREAS[i % AREAS.length];
  const index = Math.floor(i / AREAS.length) + 1;
  return {
    area,
    photo: listPhotos(area)[index],
    alt: altFor(lang, area, index),
    label: t(lang, `home.filter.${area}` as DictKey),
  };
});
---

<section class="featured" data-featured>
  <div class="featured__inner">
    <div class="featured__head">
      <h2 class="featured__title">{t(lang, 'home.featured.title')}</h2>
      <div class="chips">
        {
          filters.map((f) => (
            <button
              type="button"
              class="chip"
              data-filter={f}
              aria-pressed={f === 'all' ? 'true' : 'false'}
            >
              {t(lang, `home.filter.${f}` as DictKey)}
            </button>
          ))
        }
      </div>
    </div>
    <ul class="series">
      {
        items.map((item) => (
          <li class="series__item" data-area={item.area}>
            <Image
              class="series__photo"
              src={item.photo}
              alt={item.alt}
              widths={[400, 640, 960]}
              sizes="(min-width: 900px) 25vw, (min-width: 600px) 50vw, 50vw"
              format="webp"
              loading="lazy"
            />
            <span class="series__scrim" aria-hidden="true" />
            <span class="series__area">{item.label}</span>
            <span class="series__name">{t(lang, 'home.series.placeholder')}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import '../scripts/filter';
</script>

<style>
  .featured {
    padding: 32px clamp(20px, 5vw, 64px) 112px;
  }
  .featured__inner {
    max-width: 1312px;
    margin: 0 auto;
  }
  .featured__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }
  .featured__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.1;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chip {
    min-height: 44px;
    padding: 0 20px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    border-radius: 2px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
  }
  .chip[aria-pressed='true'] {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }
  .series {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .series__item {
    position: relative;
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    overflow: hidden;
    border-radius: 2px;
    color: #ffffff;
    background: #14110c;
  }
  .series__item[hidden] {
    display: none;
  }
  .series__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .series__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 40%, rgba(0, 0, 0, 0.78) 100%);
  }
  .series__area,
  .series__name {
    position: relative;
  }
  .series__area {
    margin-bottom: 6px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }
  .series__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.15;
  }

  @media (max-width: 768px) {
    .featured {
      padding: 16px clamp(20px, 5vw, 64px) 64px;
    }
    .featured__head {
      gap: 16px;
      margin-bottom: 24px;
    }
    .chips {
      flex-wrap: nowrap;
      width: 100%;
      gap: 8px;
      overflow-x: auto;
    }
    .chip {
      flex: 0 0 auto;
      padding: 0 18px;
    }
    .series {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .series__item {
      padding: 12px;
    }
    .series__area {
      margin-bottom: 4px;
      font-size: 10px;
      letter-spacing: 0.16em;
    }
    .series__name {
      font-size: 18px;
    }
  }
</style>
