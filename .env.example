# Defina pelo menos UMA das duas variáveis abaixo. Sem nenhuma, o formulário de orçamento não
# entrega nada e `npm run check` FALHA (para liberar só em build local: ALLOW_UNCONFIGURED=1).
# O ideal é definir as duas.

# E-mail de contato. Aparece no rodapé e no link de e-mail (mailto) do formulário, e é a
# forma de envio quando não há chave do Web3Forms (o pedido sai pelo app de e-mail da pessoa,
# com o endereço visível para copiar). É público: fica no HTML do site.
PUBLIC_CONTACT_EMAIL=

# Chave pública do Web3Forms. É pública por desenho (fica visível no HTML do site)
# e gratuita. Crie em https://web3forms.com usando o e-mail que vai receber os pedidos.
# Com ela, o pedido é enviado pelo próprio site; o mailto fica como reserva se o envio falhar
# (e só existe se PUBLIC_CONTACT_EMAIL também estiver definido).
PUBLIC_WEB3FORMS_KEY=
