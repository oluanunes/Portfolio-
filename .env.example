# Defina pelo menos UMA das duas variáveis abaixo; sem isso, ninguém consegue falar com você
# pelo formulário. O ideal é definir as duas.

# Chave pública do Web3Forms. É pública por desenho (fica visível no HTML do site)
# e gratuita. Crie em https://web3forms.com usando o e-mail que vai receber os pedidos.
# Sem ela, o formulário não envia nada pelo site: só oferece o link de e-mail (mailto),
# e esse link depende de PUBLIC_CONTACT_EMAIL.
PUBLIC_WEB3FORMS_KEY=

# E-mail de contato usado no link de reserva (mailto) quando o envio falha ou a chave
# falta. Sem ele, o link não aparece e só a mensagem é mostrada.
PUBLIC_CONTACT_EMAIL=
